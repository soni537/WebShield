# Flask Configuration
SECRET_KEY=change-this-to-a-long-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=0

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=webshield
DB_USER=webshield_user
DB_PASSWORD=change-this-password

# Scanner Settings
SCANNER_TIMEOUT=15
SCANNER_MAX_RESPONSE_SIZE=5242880
SCANNER_MAX_REQUESTS_PER_SCAN=20
RATE_LIMIT_PER_MINUTE=10

# Allowlist Mode (comma-separated hostnames; leave empty to disable strict allowlist in dev)
SCAN_ALLOWLIST=

# Demo mode: uses simulated responses when target is unavailable
DEMO_MODE=0
